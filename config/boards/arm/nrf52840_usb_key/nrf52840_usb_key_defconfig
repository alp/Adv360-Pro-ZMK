CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_NRF52840_USB_KEY=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable GPIO
CONFIG_GPIO=y

# Pin control (required by USB driver)
CONFIG_PINCTRL=y

# Enable writing to flash (for BLE pairing and settings persistence)
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# 32kHz crystal (internal to MDBT50Q-RX module)
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_150PPM=y

# BT high power for better range
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Build UF2 output for TinyUF2 bootloader
CONFIG_BUILD_OUTPUT_UF2=y
